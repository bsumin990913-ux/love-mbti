{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "//": "그림은 내용이 바뀌면 파일을 다시 굽는 쪽이라 하루는 그냥 재사용한다. stale-while-revalidate 로 만료 뒤에도 일단 캐시본을 보여주고 뒤에서 갱신한다",
      "source": "/(char/web|pick-art)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "//": "og 이미지는 크롤러가 가져간다. 사람 눈앞의 로딩과는 무관해서 길게 잡아도 안전하다",
      "source": "/og-(home|mbti|love|ideal).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "//": "아이콘류",
      "source": "/(favicon.svg|apple-touch-icon.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "//": "css/js 는 파일명에 해시가 안 붙는다. 오래 캐시하면 문항을 고쳐도 옛날 게 나가므로 매번 물어보게 둔다 (변경 없으면 304 라 사실상 공짜다)",
      "source": "/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "//": "관리자 화면은 검색엔진에 걸리면 안 된다",
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
